  "system_database_guard": {
    "_comment": "系统库维度的问题按 severity_cap 封顶：master/model/msdb 的备份、完整性检查、文件增长与所有权链属于「建议项」，用与业务库同级的 critical 会把真正的业务风险稀释掉（实测一例：9 个 critical 里 6 个来自系统库，真正的业务库风险被埋没）。tempdb 已在 excluded_databases 里整条不评价。这里只声明「哪些规则、哪些库、封到哪一级」，判定逻辑仍在 rules.py。",
    "databases": [
      "master",
      "model",
      "msdb"
    ],
    "severity_cap": "low",
    "applies_to": [
      "BACKUP.FULL",
      "BACKUP.NO_BACKUP",
      "BACKUP.LOG",
      "DB.CHECKDB",
      "DB.CHAINING",
      "FILE.PERCENT_GROWTH",
      "DB.TRUSTWORTHY"
    ]
  },
  "excluded_databases": [
    "tempdb"
  ],
  "ignored_wait_types": [
    "BROKER_EVENTHANDLER",
    "BROKER_RECEIVE_WAITFOR",
