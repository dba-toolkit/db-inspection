{
  "schema_version": "1.0",
  "thresholds": {
    "backup_full_max_age_hours": 168,
    "backup_log_max_age_minutes": 60,
    "checkdb_max_age_days": 14,
    "file_io_warning_ms": 20,
    "file_io_critical_ms": 50,
    "file_free_warning_pct": 15,
    "blocking_warning_seconds": 60,
    "long_request_seconds": 300,
    "tempdb_used_warning_pct": 80,
    "failed_job_lookback_hours": 24,
    "max_sysadmin_logins": 5,
    "max_memory_of_physical_pct": 90,
    "min_cost_threshold_parallelism": 25,
    "max_recommended_maxdop": 8,
    "ple_warning_seconds": 300,
    "memory_grants_pending_warning": 0,
    "ag_queue_warning_mb": 512,
    "ag_sync_health_required": "HEALTHY",
    "volume_free_warning_pct": 20,
    "volume_free_critical_pct": 10,
    "log_used_warning_pct": 80,
    "log_used_critical_pct": 90,
    "vlf_warning_count": 200,
    "vlf_critical_count": 1000,
    "stale_stats_days": 14,
    "stale_stats_modification_pct": 20,
    "index_fragmentation_warning_pct": 30,
    "index_min_page_count": 1000,
    "job_failure_lookback_hours": 24,
    "job_overdue_hours": 36,
    "log_shipping_warning_minutes": 60,
    "memory_utilization_warning_pct": 95,
    "single_db_cache_warning_pct": 60,
    "large_table_warning_mb": 10240,
    "recommend_rcsi_for_user_db": true,
    "single_source_connection_warning": 50,
    "require_backup_checksum": true,
    "require_backup_encryption": false,
    "require_query_store_for_user_db": true
  },
  "excluded_databases": ["tempdb"],
  "ignored_wait_types": [
    "BROKER_EVENTHANDLER", "BROKER_RECEIVE_WAITFOR", "BROKER_TASK_STOP",
    "BROKER_TO_FLUSH", "CHECKPOINT_QUEUE", "CLR_AUTO_EVENT", "CLR_MANUAL_EVENT",
    "DBMIRROR_EVENTS_QUEUE", "DIRTY_PAGE_POLL", "DISPATCHER_QUEUE_SEMAPHORE",
    "FT_IFTS_SCHEDULER_IDLE_WAIT", "HADR_FILESTREAM_IOMGR_IOCOMPLETION",
    "HADR_TIMER_TASK", "HADR_WORK_QUEUE", "KSOURCE_WAKEUP", "LAZYWRITER_SLEEP",
    "LOGMGR_QUEUE", "ONDEMAND_TASK_QUEUE", "QDS_PERSIST_TASK_MAIN_LOOP_SLEEP",
    "REQUEST_FOR_DEADLOCK_SEARCH", "RESOURCE_QUEUE", "SLEEP_TASK", "SLEEP_SYSTEMTASK",
    "SQLTRACE_BUFFER_FLUSH", "WAITFOR", "XE_DISPATCHER_WAIT", "XE_TIMER_EVENT"
  ]
}
