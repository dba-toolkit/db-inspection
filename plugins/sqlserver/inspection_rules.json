    "min_cost_threshold_parallelism": 25,
    "max_recommended_maxdop": 8,
    "ple_warning_seconds": 300,
    "memory_grants_pending_warning": 0,
    "ag_queue_warning_mb": 512,
    "ag_sync_health_required": "HEALTHY",
    "ag_replica_lag_warning_seconds": 30,
    "require_service_autostart": true,
    "volume_free_warning_pct": 20,
    "volume_free_critical_pct": 10,
    "log_used_warning_pct": 80,
    "log_used_critical_pct": 90,
    "vlf_warning_count": 200,
    "vlf_critical_count": 1000,
    "stale_stats_days": 14,
    "stale_stats_modification_pct": 20,
    "index_fragmentation_warning_pct": 30,
    "index_min_page_count": 1000,
    "job_overdue_hours": 36,
    "log_shipping_warning_minutes": 60,
    "memory_utilization_warning_pct": 95,
    "single_db_cache_warning_pct": 60,
    "large_table_warning_mb": 10240,
    "recommend_rcsi_for_user_db": true,
    "single_source_connection_warning": 50,
    "require_backup_checksum": true,
    "require_backup_encryption": false,
    "require_query_store_for_user_db": true,
    "require_adhoc_workloads_optimization": true,
    "blocked_process_threshold_min_seconds": 30,
    "require_backup_compression": false,
    "sqlserver_eol_warning_days": 180,
    "session_cpu_share_warning_pct": 80,
    "session_cpu_min_total_ms": 600000,
    "session_min_session_count": 10,
    "sqlserver_extended_support_end": {
